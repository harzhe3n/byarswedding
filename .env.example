# Copy this file to .env.local for local development,
# and add the same two variables in Vercel → Project → Settings → Environment Variables.
# Find both values in Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The public "anon" key (or the newer "publishable" key). Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: full site address, used for link previews. Filled automatically on Vercel.
# VITE_SITE_URL=https://byar-lanya.vercel.app
